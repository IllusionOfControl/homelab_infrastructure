# ==========================================
# Homelab DNS Configuration (dnsmasq)
# ==========================================

# Basic security and performance settings
domain-needed
bogus-priv
no-resolv
no-poll
no-hosts
cache-size=1000

# Homelab domain Zone
domain={{ dns_domain }}
local=/{{ dns_domain }}/
expand-hosts

# Listening interfaces
{% set dns_listen_ips = ['127.0.0.1'] %}
{% if ansible_default_ipv4.address is defined and ansible_default_ipv4.address not in dns_listen_ips %}
{% set _ = dns_listen_ips.append(ansible_default_ipv4.address) %}
{% endif %}
{% if proxmox_internal_gateway is defined and proxmox_internal_gateway not in dns_listen_ips %}
{% set _ = dns_listen_ips.append(proxmox_internal_gateway) %}
{% endif %}
{% if hostvars[inventory_hostname]['ansible_host'] is defined and hostvars[inventory_hostname]['ansible_host'] is match('^\\d+\\.\\d+\\.\\d+\\.\\d+$') and hostvars[inventory_hostname]['ansible_host'] not in dns_listen_ips %}
{% set _ = dns_listen_ips.append(hostvars[inventory_hostname]['ansible_host']) %}
{% endif %}
{% for iface in ansible_facts['interfaces'] | default([]) if iface is match('^zt') %}
{% set zt_ip = (ansible_facts[iface]['ipv4']['address'] | default('')) if (ansible_facts[iface] is defined and ansible_facts[iface]['ipv4'] is defined) else '' %}
{% if zt_ip and zt_ip not in dns_listen_ips %}
{% set _ = dns_listen_ips.append(zt_ip) %}
{% endif %}
{% endfor %}
{% for ip in dns_listen_ips %}
listen-address={{ ip }}
{% endfor %}
bind-dynamic

# Upstream DNS servers
{% for server in dns_upstream_servers %}
server={{ server }}
{% endfor %}

# Local DNS records for Homelab devices and services
{% for record in dns_records %}
address=/{{ record.name }}.{{ dns_domain }}/{{ record.ip }}
address=/{{ record.name }}/{{ record.ip }}
{% endfor %}
